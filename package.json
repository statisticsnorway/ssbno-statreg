{
  "name": "ssbno-statreg",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --ws && cp -Rf frontend/dist/* backend/dist",
    "start": "npm run start -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "check": "npm run build -w shared && tsc --noEmit -p backend && tsc -b frontend",
    "test": "vitest --exclude '**/integration/**'",
    "ci-test": "vitest run  --exclude '**/integration/**'",
    "test:backend": "vitest --project backend",
    "test:frontend": "vitest --project frontend",
    "test:integration": "vitest run --project integration",
    "test:integration:docker": "docker-compose -f docker-compose-test.yaml down --remove-orphans --volumes && docker-compose -f docker-compose-test.yaml up --build --abort-on-container-exit --exit-code-from tests --remove-orphans ; docker-compose -f docker-compose-test.yaml down --remove-orphans --volumes",
    "dev:auth": "docker-compose --env-file ./backend/.env up --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "seed": "npm run seed -w backend",
    "generate": "npm run generate -w backend",
    "generate:api-types": "openapi-typescript ./shared/openapi/openapi.yaml | prettier --parser typescript > ./shared/src/api-types.ts"
  },
  "overrides": {
    "hono": "4.12.26",
    "valibot": "1.2.0",
    "body-parser": "2.2.1",
    "fastify": "5.8.5",
    "qs": "6.14.1",
    "lodash": "4.17.23",
    "vite": {
      "rollup": "npm:@rollup/wasm-node"
    }
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.9.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.2",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "eslint": "10.5.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": false
  }
}