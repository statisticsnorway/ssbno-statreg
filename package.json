{
  "name": "ssbno-statreg-api",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nodemon -w src/server -x tsx src/main.mts",
    "start": "NODE_ENV=production tsx src/main.mts",
    "build": "vite build",
    "lint": "eslint '**/*.{js,mjs,cjs,ts}'",
    "lint:fix": "eslint --fix '**/*.{js,mjs,cjs,ts}'",
    "types:clean": "rm -rf src/types/*.d.ts",
    "types:gen": "npm run types:clean && ts-node openapi/generate-types.ts",
    "api:gen": "ts-node openapi/generate-api.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "eslint": "^9.16.0",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.10",
    "openapi-typescript": "^7.10.1",
    "swagger-typescript-api": "^13.2.16",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.3.3"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-express": "*"
  }
}
