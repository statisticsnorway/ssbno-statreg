{
  "name": "ssbno-statreg",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm --filter 'backend' run dev\" \"pnpm --filter 'frontend' run dev\"",
    "build": "pnpm -r run build && cp -Rf frontend/dist/* backend/dist",
    "start": "pnpm --filter 'backend' run start",
    "db:deploy": "pnpm --filter 'backend' run db:deploy",
    "check": "tsc --noEmit -p backend && tsc -b frontend",
    "test": "vitest --exclude '**/integration/**'",
    "ci-test": "vitest run  --exclude '**/integration/**'",
    "test:backend": "vitest --project backend",
    "test:frontend": "vitest --project frontend",
    "test:integration:local": "pnpm --filter 'backend' run test:integration:local",
    "test:integration:local:force": "pnpm --filter 'backend' run test:integration:local:force",
    "test:integration:docker": "docker-compose -f docker-compose-test.yaml down --remove-orphans --volumes && docker-compose -f docker-compose-test.yaml up --build --abort-on-container-exit --exit-code-from tests --remove-orphans ; docker-compose -f docker-compose-test.yaml down --remove-orphans --volumes",
    "dev:auth": "docker-compose --env-file ./backend/.env up --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "seed": "pnpm --filter 'backend' run seed",
    "generate": "pnpm --filter 'backend' run generate",
    "generate:api-types": "openapi-typescript ./shared/openapi/openapi.yaml -o ./shared/src/api-types.ts && prettier --write ./shared/src/api-types.ts"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
