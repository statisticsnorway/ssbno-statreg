{
  "name": "ssbno-statreg",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend",
    "start": "npm run start -w backend",
    "ci-test": "npm run ci-test -w backend",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "lint": "eslint '**/*.{js,mjs,cjs,ts}'",
    "lint:fix": "eslint --fix '**/*.{js,mjs,cjs,ts}'",
    "seed": "npm run seed -w backend",
    "generate": "npm run generate -w backend",
    "generate:api-types": "npm run generate:api-types -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.4.0"
  }
}
