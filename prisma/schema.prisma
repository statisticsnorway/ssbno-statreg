generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["statreg"]
}

model Frequency {
  @@schema("statreg")
  id      Int    @id @default(autoincrement())
  version Int       
  name    String    
  code    String    @unique
  variant Variant[]
}

model Calender_date {
  @@schema("statreg")
  id      Int      @id @default(autoincrement())
  version Int
  comment String
  day     DateTime @db.Timestamp(6) @unique
}

model Contact_DoNotUse {
  @@schema("statreg")
  id                 Int      @id @default(autoincrement())
  version            Int      
  initials           String?  
  mobile             String?  
  name               String   
  last_updated       DateTime @db.Timestamp(6)
  phone              String?  
  email              String
  date_created       DateTime @db.Timestamp(6)
  inactiv            Boolean?
  name_en            String?
  statistic_contacts Statistic_contacts[]
}

model Shortname {
  @@schema("statreg")
  id           Int         @id @default(autoincrement())
  version      Int
  name         String      @unique
  last_updated DateTime    @db.Timestamp(6)
  date_created DateTime    @db.Timestamp(6)
  statistic   Statistic?
}

model Release {
  @@schema("statreg")
  id                     Int      @id @default(autoincrement())
  version                Int
  publish_time           DateTime @db.Timestamp(6)
  has_versions           Boolean
  last_updated           DateTime @db.Timestamp(6)
  comment                String 
  period_to              DateTime @db.Timestamp(6)
  desk_appoval_status    String? 
  variant_id             Int
  period_from            DateTime @db.Timestamp(6)
  cancelled              Boolean  @default(false)
  date_created           DateTime @db.Timestamp(6)
  release_date_precision String
  import_flag            Boolean?
  variant                Variant  @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Region_level {
  @@schema("statreg")
  id                      Int     @id @default(autoincrement())
  version                 Int
  name                    String
  code                    String? @unique
  statistic_region_levels Statistic_region_level[]
}

model Division_DoNotUse {
  @@schema("statreg")
  id         Int         @id @default(autoincrement())
  version    Int         
  code       String      @unique
  name_en    String
  name       String
  statistics Statistic[]
}

model Statistic {
  @@schema("statreg")
  id                      Int                      @id @default(autoincrement())
  version                 Int
  shortname_id            Int                      @unique
  dir_appoval_status      String?
  search_phrases          String?
  priority                Int
  desk_appoval_status     String?
  language                String
  search_phrases_en       String?
  division_id             Int
  first_release           DateTime?                @db.Timestamp(6)
  yearly_reporting        Boolean
  status                  String
  relation_id             Int?
  name                    String
  last_updated            DateTime                 @db.Timestamp(6)
  comment                 String
  name_en                 String?
  date_created            DateTime                 @db.Timestamp(6)
  legacy_topic_codes      String?
  statistic               Statistic?               @relation("STATISTICToSTATISTIC", fields: [relation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_statistics        Statistic[]              @relation("STATISTICToSTATISTIC")
  division                Division_DoNotUse                 @relation(fields: [division_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shortname               Shortname                @relation(fields: [shortname_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts                Statistic_contacts[]
  statistic_region_levels Statistic_region_level[]
  variants                Variant[]
}

model Statistic_contacts {
  @@schema("statreg")
  statistic_id Int
  contact_id   Int
  contacts_idx Int?
  contact      Contact_DoNotUse   @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statistic    Statistic @relation(fields: [statistic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([statistic_id, contact_id])
}

model Statistic_region_level {
  @@schema("statreg")
  region_level_id Int
  statistic_id    Int
  region_level    Region_level @relation(fields: [region_level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statistic       Statistic    @relation(fields: [statistic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([statistic_id, region_level_id])
}

// Restriction: can not create two _Variant_ with both the same statistic AND the same frequency
model Variant {
  @@schema("statreg")
  id                 Int       @id @default(autoincrement())
  version            Int
  last_updated       DateTime  @db.Timestamp(6)
  date_created       DateTime  @db.Timestamp(6)
  cancelled          Boolean
  freq_id            Int
  revision           String
  statistic_id       Int
  level_of_detail    String?
  level_of_detail_en String?
  releases           Release[]
  frequency          Frequency @relation(fields: [freq_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statistic          Statistic @relation(fields: [statistic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
