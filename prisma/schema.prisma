generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Frekvens {
  id      Decimal   @id(map: "sys_c0023870") @db.Decimal(19, 0)
  version Decimal   @db.Decimal(19, 0)
  navn    String    @db.VarChar(50)
  kode    String    @db.VarChar(50)
  variant Variant[]

}

model Kalender_dato {
  id        Decimal  @id(map: "sys_c0023875") @db.Decimal(19, 0)
  version   Decimal  @db.Decimal(19, 0)
  kommentar String   @db.VarChar(255)
  dag       DateTime @db.Timestamp(6)

}

model Kontakt {
  id                   Decimal                @id(map: "sys_c0023890") @db.Decimal(19, 0)
  version              Decimal                @db.Decimal(19, 0)
  initialer            String?                @db.VarChar(3)
  mobil                String?                @db.VarChar(30)
  navn                 String                 @db.VarChar(130)
  last_updated         DateTime               @db.Timestamp(6)
  telefon              String?                @db.VarChar(30)
  epost                String                 @db.VarChar(100)
  date_created         DateTime               @db.Timestamp(6)
  inaktiv              Decimal?               @db.Decimal(1, 0)
  navn_en              String?                @db.VarChar(130)
  statistikk_kontakter Statistikk_kontakter[]

}

model Kortnavn {
  id           Decimal      @id(map: "sys_c0023896") @db.Decimal(19, 0)
  version      Decimal      @db.Decimal(19, 0)
  navn         String       @db.VarChar(20)
  last_updated DateTime     @db.Timestamp(6)
  date_created DateTime     @db.Timestamp(6)
  statistikk   Statistikk[]

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Publisering {
  id               Decimal  @id(map: "sys_c0023910") @db.Decimal(19, 0)
  version          Decimal  @db.Decimal(19, 0)
  tidspunkt        DateTime @db.Timestamp(6)
  er_endret        Decimal  @db.Decimal(1, 0)
  last_updated     DateTime @db.Timestamp(6)
  intern_kommentar String   @db.VarChar(255)
  periode_til      DateTime @db.Timestamp(6)
  desk_flyt        String?  @db.VarChar(255)
  variant_id       Decimal  @db.Decimal(19, 0)
  periode_fra      DateTime @db.Timestamp(6)
  er_avlyst        Decimal  @db.Decimal(1, 0)
  date_created     DateTime @db.Timestamp(6)
  datotype         String   @db.VarChar(255)
  import_flag      Decimal? @db.Decimal(1, 0)
  variant          Variant  @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkdb40a13c44a06f71")

}

model Regionalt_niva {
  id                          Decimal                       @id(map: "sys_c0023916") @db.Decimal(19, 0)
  version                     Decimal                       @db.Decimal(19, 0)
  navn                        String                        @db.VarChar(40)
  kode                        String?                       @db.VarChar(50)
  statistikk_regionale_nivaer Statistikk_regionale_nivaer[]

}

model Seksjon {
  id         Decimal      @id(map: "sys_c0023922") @db.Decimal(19, 0)
  version    Decimal      @db.Decimal(19, 0)
  navn       String       @db.VarChar(100)
  kode       String       @db.VarChar(3)
  navn_en    String       @db.VarChar(100)
  statistikk Statistikk[]

}

model Statistikk {
  id                          Decimal                       @id(map: "sys_c0023938") @db.Decimal(19, 0)
  version                     Decimal                       @db.Decimal(19, 0)
  kortnavn_id                 Decimal                       @db.Decimal(19, 0)
  dir_flyt                    String?                       @db.VarChar(255)
  triggerord                  String?                       @db.VarChar(500)
  prioritet                   Decimal                       @db.Decimal(1, 0)
  desk_flyt                   String?                       @db.VarChar(255)
  sprak                       String                        @db.VarChar(255)
  triggerord_en               String?                       @db.VarChar(500)
  eierseksjon_id              Decimal                       @db.Decimal(19, 0)
  forstegangspublisering      DateTime?                     @db.Timestamp(6)
  arsrapportering             Decimal                       @db.Decimal(1, 0)
  status                      String                        @db.VarChar(255)
  gamle_emnekoder             String?                       @db.VarChar(255)
  relasjon_id                 Decimal?                      @db.Decimal(19, 0)
  statistikknavn              String                        @db.VarChar(140)
  last_updated                DateTime                      @db.Timestamp(6)
  intern_kommentar            String                        @db.VarChar(255)
  statistikknavn_en           String?                       @db.VarChar(140)
  date_created                DateTime                      @db.Timestamp(6)
  statistikk                  Statistikk?                   @relation("STATISTIKKToSTATISTIKK", fields: [relasjon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkfa5cb2137008a78")
  other_statistikk            Statistikk[]                  @relation("STATISTIKKToSTATISTIKK")
  seksjon                     Seksjon                       @relation(fields: [eierseksjon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkfa5cb213b101b242")
  kortnavn                    Kortnavn                      @relation(fields: [kortnavn_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkfa5cb213c47ad723")
  statistikk_kontakter        Statistikk_kontakter[]
  statistikk_regionale_nivaer Statistikk_regionale_nivaer[]
  variant                     Variant[]

}

model Statistikk_kontakter {
  statistikk_id Decimal    @db.Decimal(19, 0)
  kontakt_id    Decimal    @db.Decimal(19, 0)
  kontakter_idx Decimal?   @db.Decimal(10, 0)
  kontakt       Kontakt    @relation(fields: [kontakt_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkf98634a159382591")
  statistikk    Statistikk @relation(fields: [statistikk_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkf98634a1d978a9a3")

  @@id([statistikk_id, kontakt_id], map: "sys_c0023946")
}

model Statistikk_regionale_nivaer {
  regionalt_niva_id Decimal        @db.Decimal(19, 0)
  statistikk_id     Decimal        @db.Decimal(19, 0)
  regionalt_niva    Regionalt_niva @relation(fields: [regionalt_niva_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fke4b2f5b83078425c")
  statistikk        Statistikk     @relation(fields: [statistikk_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fke4b2f5b8d978a9a3")

  @@id([statistikk_id, regionalt_niva_id], map: "sys_c0023949")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Variant {
  id            Decimal       @id(map: "sys_c0023958") @db.Decimal(19, 0)
  version       Decimal       @db.Decimal(19, 0)
  frekvens_id   Decimal       @db.Decimal(19, 0)
  last_updated  DateTime      @db.Timestamp(6)
  revisjon      String        @db.VarChar(255)
  statistikk_id Decimal       @db.Decimal(19, 0)
  detaljniva_en String?       @db.VarChar(255)
  detaljniva    String?       @db.VarChar(255)
  er_opphort    Decimal       @db.Decimal(1, 0)
  date_created  DateTime      @db.Timestamp(6)
  publisering   Publisering[]
  frekvens      Frekvens      @relation(fields: [frekvens_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fke1d1085b8b4eb03")
  statistikk    Statistikk    @relation(fields: [statistikk_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fke1d1085d978a9a3")

}
