{
  "restartable": "rs",
  "ignore": [".git", "node_modules/**/node_modules"],
  "verbose": false,
  "events": {},
  "watch": ["src", "src/**"],
  "env": {
    "AUTH_ENABLED": "true",
    "PORT": "8080",
    "KEYCLOAK_REALM_ISSUER": "https://auth-play.test.ssb.no/realms/ssb",
    "KEYCLOAK_JWKS_URI": "https://auth-play.test.ssb.no/realms/ssb/protocol/openid-connect/certs",
    "KEYCLOAK_TOKEN_AUDIENCE": "oauth2-proxy-ssbno-statreg-api"
  },
  "ext": "mts,ts",
  "exec": "tsx src/main.ts"
}
