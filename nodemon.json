{
  "restartable": "rs",
  "ignore": [
    ".git",
    "node_modules/**/node_modules"
  ],
  "verbose": false,
  "events": {},
  "watch": [
    "src",
    "src/**"
  ],
  "env": {
    "NODE_ENV": "development",
    "AUTH_ENABLED": "true",
    "PORT": "8080",
    "KEYCLOAK_PLAY_REALM_ISSUER": "https://auth-play.test.ssb.no/realms/ssb",
    "KEYCLOAK_PLAY_JWKS_URI": "https://auth-play.test.ssb.no/realms/ssb/protocol/openid-connect/certs",
    "KEYCLOAK_PLAY_TOKEN_AUDIENCE": "oauth2-proxy-ssbno-statreg-api"
  },
  "ext": "mts,ts",
  "exec": "tsx src/main.ts"
}